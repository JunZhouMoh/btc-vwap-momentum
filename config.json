{
  "_docs": "Full parameter guide: see CONFIG.md",

  "market": {
    "_comment": "5 or 15 — slug btc-updown-5m-<epoch> or btc-updown-15m-<epoch>",
    "interval_minutes": 5
  },

  "strategy": {
    "min_price": 0.9,
    "max_price": 0.99,
    "dangerous": true,
    "_comment_5m": "Below min_elapsed / no_entry_cutoff are scaled for 5m (300s). For 15m, raise e.g. min_elapsed_sec 530, no_entry_before_end_sec 335.",
    "min_elapsed_sec": 270,
    "min_deviation_pct": -100,
    "max_deviation_pct": 100,
    "no_entry_before_end_sec": 0,
    "momentum_window_sec": 60,
    "vwap_window_sec": 30,
    "win_rate_csv": "data/win_rate.csv",
    "momentum_min_pct": -10,
    "volume_acceleration_check": {
      "enabled": true,
      "window_sec": 10,
      "threshold": 5000.0,
      "require_current_volume_lead": true,
      "min_accel_diff": 0.0,
      "min_current_volume_diff": 5000.0
    },
    "volume_eval_mode": {
      "enabled": true,
      "time_left_sec": 50,
      "min_contracts": 1,
      "max_trades": 1,
      "buffer_avg_multiplier": 1.25,
      "min_buffer_threshold_usd": 30.0,
      "volume_check_enabled": true,
      "entry_min_current_volume_diffs": [1000, 2000, 3000],
      "min_price": 0.84,
      "max_price": 0.96
    },
    "late_entry_modes": {
      "enabled": true,
      "total_max_trades": 3,
      "mode_40s": {
        "enabled": true,
        "time_left_sec": 40,
        "min_contracts": 30,
        "max_trades": 1,
        "buffer_avg_multiplier": 1,
        "min_buffer_threshold_usd": 25.0,
        "min_price": 0.8,
        "max_price": 0.97
      },
      "mode_30s": {
        "enabled": true,
        "time_left_sec": 30,
        "min_contracts": 30,
        "max_trades": 1,
        "buffer_avg_multiplier": 1.0,
        "min_buffer_threshold_usd": 25.0,
        "min_price": 0.85,
        "max_price": 0.97
      },
      "mode_20s": {
        "enabled": true,
        "time_left_sec": 20,
        "min_contracts": 30,
        "max_trades": 1,
        "buffer_avg_multiplier": 0.5,
        "min_buffer_threshold_usd": 20.0,
        "min_price": 0.9,
        "max_price": 0.97
      },
      "mode_70s": {
        "enabled": true,
        "time_left_sec": 70,
        "min_contracts": 30,
        "max_trades": 1,
        "buffer_avg_multiplier": 1.0,
        "min_buffer_threshold_usd": 25.0,
        "min_price": 0.85,
        "max_price": 0.97
      }
    }
  },

  "entry": {
    "bet_amount_usd": 2,
    "price_offset": 0.02,
    "order_type": "FAK",
    "max_retries": 3,
    "retry_delay_ms": 300,
    "fill_timeout_ms": 1000,
    "min_contracts": 1,
    "min_order_usd": 1,
    "max_entry_price": 0.99,
    "ws_recovery_timeout_sec": 10
  },

  "hedge": {
    "enabled": true,
    "hedge_price": 0.02,
    "order_type": "GTD",
    "max_retries": 3,
    "retry_delay_ms": 1000
  },

  "redeem": {
    "enabled": true,
    "interval_seconds": 180,
    "auto_confirm": true
  },

  "simulation": {
    "_comment": "Paper trading: live market data, no CLOB orders or redeemer. API keys optional when enabled.",
    "enabled": false,
    "separate_trading_log": true,
    "trading_log_path": "logs/trading_log_sim.json",
    "history_csv_path": "logs/simulation_trades.csv",
    "history_jsonl_path": "logs/simulation_history.jsonl",
    "history_summary_path": "logs/simulation_summary.json"
  },

  "telegram": {
    "enabled": true,
    "chart_every_n_trades": 5
  },

  "web_dashboard": {
    "_comment": "Open http://127.0.0.1:PORT/ (not https). If the page fails, avoid typing only localhost (IPv6). Use 0.0.0.0 to listen on all IPv4 interfaces.",
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8765
  },

  "logging": {
    "level": "WARNING",
    "file_rotation_hours": 3
  },
  "polymarket": {
    "_comment": "API keys only required for simulation mode, but recommended for higher rate limits even in live trading.",
    "clob_host": "https://clob.polymarket.com",
    "chain_id": "",
    "signature_type": ""
  },
  "btc_price_feed": {
    "provider": "chainlink",
    "ws_url": ""
  },
  "buffer": 25.0
}
